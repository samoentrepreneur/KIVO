# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/KIVO?retryWrites=true&w=majority

# VPS backend
PORT=8001

# Frontend origin on the VPS (Vite default development port)
FRONTEND_URL=http://212.56.46.39:5173
CLIENT_URL=http://212.56.46.39:5173

# Authentication secrets: generate unique random values; never commit real secrets
ACCESS_SECRET=replace_with_a_long_random_secret
REFRESH_SECRET=replace_with_a_different_long_random_secret
RESET_SECRET=replace_with_another_long_random_secret

# Optional at startup; required for OTP and password-reset email delivery
RESEND_API_KEY=
FROM_EMAIL=
